# ==============================================================================
# LAST CITY — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Instructions: Copy this file to '.env.local' or '.env' and fill in real values.
# DO NOT commit real API keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT WEB CONFIGURATION (Public credentials)
# ------------------------------------------------------------------------------
# How to collect:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Select or create your Firebase project ("last-city").
# 3. Click Project Overview (gear icon) -> Project settings -> General tab.
# 4. Under "Your apps", click the Web icon '</>' to register a new Web App (e.g. "LastCityWeb").
# 5. Copy the 'firebaseConfig' object values provided into the fields below:

# Obtain from: firebaseConfig.apiKey
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here

# Obtain from: firebaseConfig.authDomain (Format: <project-id>.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Obtain from: firebaseConfig.projectId
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# Obtain from: firebaseConfig.storageBucket (Format: <project-id>.firebasestorage.app)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Obtain from: firebaseConfig.messagingSenderId (Numerical Sender ID)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Obtain from: firebaseConfig.appId (Format: 1:<sender_id>:web:<app_hash>)
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Obtain from: firebaseConfig.measurementId (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id


# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN / SERVER-SIDE CONFIGURATION (Secret credentials)
# ------------------------------------------------------------------------------
# How to collect:
# 1. Go to Firebase Console -> Project Settings -> Service accounts tab.
# 2. Click "Generate new private key", which downloads a JSON service account file.
# 3. Extract the fields below (used ONLY by Next.js API routes / Cloud Functions, never client-side).

# Obtain from: serviceAccountKey.json -> private_key
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Obtain from: serviceAccountKey.json -> client_email
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com


# ------------------------------------------------------------------------------
# 3. UNITY WEBGL BUILD HOSTING & CONFIGURATION
# ------------------------------------------------------------------------------
# How to collect:
# 1. In Unity, export a WebGL build to 'web/public/game-build/'.
# 2. The build generates a framework JSON file at '/game-build/Build/<build_name>.json'.
# 3. Set this URL relative to the public/ directory or your CDN asset URL.

# Relative path from public/ or full CDN URL pointing to Unity WebGL loader JSON file
NEXT_PUBLIC_UNITY_BUILD_URL=/game-build/Build/game.json
